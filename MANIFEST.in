include README.md PACKAGE_README.md CREDITS.md LICENSE NOTICE Dockerfile compose.yaml requirements.lock.txt
recursive-include docs *.md *.json
recursive-include examples *.json
recursive-include infra *.tf *.md .terraform.lock.hcl
recursive-include apps *.py *.json *.txt
exclude apps/ingestion/local.settings.json
recursive-include tests *.py
recursive-include scripts *.py
global-exclude __pycache__ *.py[cod] *.db *.log *.tfstate*
